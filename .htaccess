# ======================================================================
# Root Apache Configuration for Microfinance Full-Stack Application
# Supports both local XAMPP subfolder and production root deployment
# ======================================================================

Options -Indexes
ServerSignature Off
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Pass Authorization Header to PHP FastCGI/FPM
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # 1. Protect sensitive system and project files
  RewriteRule ^(\.git|\.env|package(-lock)?\.json|composer\.(json|lock)|node_modules|\.vscode) - [F,L]

  # 2. Allow direct access to backend API
  RewriteCond %{REQUEST_URI} ^.*/backend/.*$ [NC]
  RewriteRule ^ - [L]

  # 3. Clean API shortcut: rewrite /api/{route} to backend/api/index.php?route={route}
  RewriteRule ^api/(.*)$ backend/api/index.php?route=$1 [QSA,L]

  # 4. Route asset files directly if they are requested from root
  RewriteRule ^assets/(.*)$ frontend/dist/assets/$1 [L]
  RewriteRule ^favicon\.(ico|svg|png)$ frontend/dist/$0 [L]

  # 5. Pass through physical files and directories that exist in current path
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 6. SPA Route Fallback:
  # Fallback to index.php which serves frontend/dist/index.html
  RewriteRule ^(.*)$ index.php [L]
</IfModule>

# ======================================================================
# Security Headers
# ======================================================================
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ======================================================================
# Gzip & Deflate Compression
# ======================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# ======================================================================
# Production Browser Asset Caching
# ======================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
