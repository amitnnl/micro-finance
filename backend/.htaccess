# ----------------------------------------------------------------------
# Backend Security & Access Control
# ----------------------------------------------------------------------

# Disable directory browsing
Options -Indexes

# Protect sensitive database files, environment configs, and code architecture
<FilesMatch "(^\.|\.(env|sqlite|db|sql|log|md|json|lock)|Database\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Disable HTTP/3 QUIC Alt-Svc to avoid ERR_QUIC_PROTOCOL_ERROR on Hostinger / LiteSpeed
<IfModule mod_headers.c>
  Header unset Alt-Svc
  Header always unset Alt-Svc
</IfModule>

# Pass Authorization Headers to PHP-FPM / FastCGI
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
SetEnvIf X-Authorization "(.*)" HTTP_X_AUTHORIZATION=$1

# Disallow direct browser requests to internal architecture folders
<IfModule mod_rewrite.c>
  RewriteEngine On
  CGIPassAuth On

  # Pass Authorization Header to PHP FastCGI/FPM
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteCond %{HTTP:X-Authorization} .
  RewriteRule .* - [E=HTTP_X_AUTHORIZATION:%{HTTP:X-Authorization}]

  # Allow public access only to the api directory and migration script
  RewriteRule ^api/ - [L]
  RewriteRule ^migrate\.php$ - [L]

  # Block direct execution of files in config, controllers, helpers, models
  RewriteRule ^(config|controllers|helpers|models)/ - [F,L]
</IfModule>

# Force API and backend responses to never be cached
<IfModule mod_headers.c>
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</IfModule>
